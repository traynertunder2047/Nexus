# ===== API KEYS (never commit the real .env file!) =====
# Copy this file to .env and fill in values. Load with python-dotenv.

# Have I Been Pwned - https://haveibeenpwned.com/API/Key (~$3.50/mo)
HIBP_API_KEY=

# DeHashed - https://dehashed.com (free tier)  auth: email:password or email:api_key
DEHASHED_EMAIL=
DEHASHED_PASSWORD=
DEHASHED_API_KEY=

# Telegram bot - get from @BotFather
TELEGRAM_BOT_TOKEN=

# ===== ENDPOINTS (free, no token required) =====
IP_API_URL=https://ip-api.com/json/           # ip lookup -> lat/lon, country, ISP
SHERLOCK_DATA_URL=https://raw.githubusercontent.com/sherlock-project/sherlock/master/sherlock/resources/data.json   # social media URL list
