# ===== API KEYS (never commit the real .env file!) =====
# Copy this file to .env and fill in values. Load with python-dotenv.

# Atlas (Mode 1, text place search) - forward geocoding
GOOGLE_GEOCODING_API_KEY=   # https://console.cloud.google.com (optional third provider)
ATLAS_USE_COUNTRY_PRIOR=1   # 0 = disable language->country filtering

# Locus (Mode 3, photo geolocation) - reverse image search (each stage skips itself if the key is empty)
# Doppelganger (Mode 2, face search) shares the same keys for its reverse-image stage
GOOGLE_VISION_API_KEY=      # https://console.cloud.google.com (webDetection)
SERPAPI_API_KEY=            # https://serpapi.com
TINEYE_PUBLIC_KEY=          # https://tineye.com/api (paid)
TINEYE_PRIVATE_KEY=         # https://tineye.com/api (paid)
SAUCENAO_API_KEY=           # https://saucenao.com
NOMINATIM_USER_AGENT=OSINTNexusBot/1.0   # required by Nominatim usage policy
PHOTO_GEOLOC_USE_GEOCLIP=0  # 1 = enable heavy GeoCLIP stage (torch + GPU recommended)
PHOTO_GEOLOC_USE_SOLAR=0    # 1 = enable solar orientation stage

# Leak-Lookup - https://leak-lookup.com (public key: ~10 free searches/day)
LEAK_LOOKUP_API_KEY=

# ===== ENDPOINTS (free, no token required) =====
IP_API_URL=https://ip-api.com/json/           # ip lookup -> lat/lon, country, ISP